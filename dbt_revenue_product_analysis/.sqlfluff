[sqlfluff]
templater = jinja
dialect = databricks
# AL07 (aliasing.forbid): disables the rule that forbids table aliases — needed for CTEs
# RF03 (references.consistent): dbt Jinja refs are sometimes flagged as inconsistent by sqlfluff
exclude_rules = AL07, RF03
runaway_limit = 10
max_line_length = 100
large_file_skip_byte_limit = 50000
ignore_comment_lines = True

[sqlfluff:templater:jinja]
apply_dbt_builtins = true

[sqlfluff:templater:jinja:macros]
dbt_utils_stub = {% macro generate_surrogate_key(field_list) %}cast(null as string){% endmacro %}{% macro date_spine(datepart, start_date, end_date) %}select cast(null as date) as date_month{% endmacro %}{% set dbt_utils = {"generate_surrogate_key": generate_surrogate_key, "date_spine": date_spine} %}

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:layout:type:comma]
spacing_before = touch
line_position = trailing

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.expression]
allow_scalar = False

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:ambiguous.column_references]  # Number in group by
group_by_and_order_by_style = implicit

[sqlfluff:layout:type:select_clause]
spacing_before = newline

[sqlfluff:layout:type:select_clause_element]
line_position = leading

[sqlfluff:rules:layout.select_targets]
wildcard_policy = single
